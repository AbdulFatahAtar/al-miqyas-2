    {
      "para_index": 2,
      "text": "\u0642\u0627\u0626\u0645\u0629 \u0645\u0647\u0627\u0645 \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0634\u0627\u0645\u0644\u0629",
      "style": "Normal"
    },
    {
      "para_index": 7,
      "text": "\u0634\u0631\u0643\u0629 \u0627\u0644\u0623\u0645\u062f \u0627\u0644\u062a\u0642\u0646\u064a\u0629 - \u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629",
      "style": "Normal"
    },
    {
      "para_index": 10,
      "text": "\u0637\u0631\u064a\u0642\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0647\u0627\u0645",
      "style": "Normal"
    },
    {
      "para_index": 12,
      "text": "\u062f\u0644\u064a\u0644 \u0627\u0644\u062d\u0627\u0644\u0627\u062a",
      "style": "Normal"
    },
    {
      "para_index": 17,
      "text": "\u0648\u0633\u0648\u0645 \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629",
      "style": "Normal"
    },
    {
      "para_index": 19,
      "text": "\u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0645\u0634\u0631\u0648\u0639",
      "style": "Normal"
    },
    {
      "para_index": 21,
      "text": "0 \u00b7 \u062d\u0633\u0645 \u0627\u0644\u0646\u0637\u0627\u0642 \u0648\u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0642\u0628\u0644 \u0627\u0644\u0628\u0631\u0645\u062c\u0629",
      "style": "Normal"
    },
    {
      "para_index": 23,
      "text": "0.1 \u062a\u062b\u0628\u064a\u062a \u0627\u0644\u0646\u0637\u0627\u0642 \u0648\u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0627\u062a",
      "style": "Normal"
    },
    {
      "para_index": 29,
      "text": "0.2 \u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u0642\u0646\u064a\u0629 \u0627\u0644\u0645\u0641\u062a\u0648\u062d\u0629",
      "style": "Normal"
    },
    {
      "para_index": 38,
      "text": "0.3 \u0645\u0624\u0634\u0631\u0627\u062a \u0627\u0644\u0646\u062c\u0627\u062d \u0648\u0627\u0644\u0645\u062e\u0627\u0637\u0631",
      "style": "Normal"
    },
    {
      "para_index": 45,
      "text": "1 \u00b7 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u062d\u0633\u0627\u0628\u0627\u062a \u0648\u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u062a\u062d\u062a\u064a\u0629 \u0627\u0644\u0645\u0645\u0644\u0648\u0643\u0629 \u0644\u0644\u0623\u0645\u062f",
      "style": "Normal"
    },
    {
      "para_index": 47,
      "text": "1.1 \u0627\u0644\u0645\u0644\u0643\u064a\u0629 \u0648\u0627\u0644\u0648\u0635\u0648\u0644",
      "style": "Normal"
    },
    {
      "para_index": 54,
      "text": "1.2 \u0627\u0644\u0628\u064a\u0626\u0627\u062a \u0648\u0627\u0644\u062f\u0648\u0645\u064a\u0646",
      "style": "Normal"
    },
    {
      "para_index": 61,
      "text": "1.3 \u0627\u0644\u0623\u0633\u0631\u0627\u0631 \u0648\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a",
      "style": "Normal"
    },
    {
      "para_index": 68,
      "text": "2 \u00b7 \u062a\u0647\u064a\u0626\u0629 \u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639 \u0648\u0645\u0639\u0627\u064a\u064a\u0631 \u0627\u0644\u062a\u0637\u0648\u064a\u0631",
      "style": "Normal"
    },
    {
      "para_index": 70,
      "text": "2.1 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0645\u0634\u0631\u0648\u0639",
      "style": "Normal"
    },
    {
      "para_index": 77,
      "text": "2.2 \u0627\u0644\u062c\u0648\u062f\u0629 \u0648\u0633\u064a\u0631 Git",
