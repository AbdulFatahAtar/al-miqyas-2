    {
      "para_index": 85,
      "text": "2.3 \u0647\u0646\u062f\u0633\u0629 \u0627\u0644\u0643\u0648\u062f",
      "style": "Normal"
    },
    {
      "para_index": 92,
      "text": "3 \u00b7 \u0625\u0639\u0627\u062f\u0629 \u062a\u0635\u0645\u064a\u0645 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0645\u0647\u0627\u062c\u0631\u0627\u062a",
