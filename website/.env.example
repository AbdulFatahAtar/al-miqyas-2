NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never rename this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters. Configure the same token in the Jotform webhook URL/header.
JOTFORM_WEBHOOK_SECRET=
# At least 32 random characters. Used only by the scheduled Jotform reconciliation endpoint.
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Required in production; used to hash network addresses for public rate limits.
ACCESS_REQUEST_RATE_LIMIT_SALT=
# Non-Vercel deployments only: a client-IP header overwritten by your trusted proxy.
# Supported values: cf-connecting-ip, x-forwarded-for, x-real-ip, x-vercel-forwarded-for.
TRUSTED_CLIENT_IP_HEADER=
